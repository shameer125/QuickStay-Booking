PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/quickstay
JWT_SECRET=change_this_to_a_long_random_string

# Local dev: do not set NODE_ENV=production (CORS stays open for any dev origin).
# Production: NODE_ENV=production and set FRONTEND_URL to your real site URL, e.g.:
# FRONTEND_URL=https://your-app.example.com

# Optional seed admin (see seedAdmin util)
# ADMIN_EMAIL=admin@quickstay.com
# ADMIN_PASSWORD=admin123
# ADMIN_NAME=Admin
